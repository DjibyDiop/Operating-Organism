organ nbia {

    // 1. Déclaration de l'état interne
    state shadow : State
    state real   : State
    state drift  : Float = 0.0

    // 2. Canaux de perception (Lecture seule depuis la télémetrie de l'organisme)
    perceive OPI.heartbeat
    perceive OPI.inference_status
    perceive Hermes.mesh_traffic
    perceive Memory.fragmentation_index

    // 3. Mémoire temporelle
    remember 60s {
        history(Memory.fragmentation_index)
        history(Hermes.mesh_traffic)
    }

    // 4. Métabolisme (Intégration régulière)
    every 1s {
        shadow.integrate(real)
        drift = distance(shadow, real)

        if drift > 0.7 {
            emit OrganismDrift(drift)
        }
    }

    // 5. Phénomènes Négatifs (Absence)
    when absence(OPI.heartbeat) for 3s {
        emit OrganismWarning("OPI_ISOLATION")
    }

    // 6. Émergence (Corrélations temporelles complexes)
    derive instability {
        from Memory.fragmentation_index, Hermes.mesh_traffic, OPI.inference_status
        
        if tendency(Memory.fragmentation_index) == INCREASING 
           and tendency(Hermes.mesh_traffic) == ERRATIC 
           and tendency(OPI.inference_status) == STALLED {
            
            emit OrganismEmergency("COGNITIVE_AND_MEMORY_STALL")
        }
    }
}
